{
    "name": "joaovitormcz/techacademy-2",
    "description": "Repositório dedicado ao projeto de TechAcademy 2",
    "type": "project",
    "require": {
        "doctrine/orm": "^3.5",
        "doctrine/dbal": "^4.3",
        "symfony/cache": "^7.3",
        "phpmailer/phpmailer": "^6.10.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "João Vitor Menezes Cortez",
            "email": "joocortezz18@gmail.com"
        }
    ],
    "scripts": {
        "create-db": "php bin/doctrine orm:schema-tool:create",
        "update-db": "php bin/doctrine orm:schema-tool:update --force",
        "start": "php -S localhost:8000 -t public"
    }
}
